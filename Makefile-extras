x-post-init-spec:
	# Give known_move/known_move_type the same name/url shape as their sibling fields
	# (gender, held_item, item, location) instead of leaving them as bare nullable
	# free-form objects, which crashes the Python generators (RuntimeException in
	# AbstractPythonCodegen$PydanticType.getType / getPydanticType, even with
	# additionalProperties: true added) on this OpenAPI 3.1 spec.
	yq -i '(.. | select(has("known_move"))) |= (.known_move = {"type": "object", "nullable": true, "required": ["name", "url"], "properties": {"name": {"type": "string"}, "url": {"type": "string", "format": "uri"}}} | .known_move_type = {"type": "object", "nullable": true, "required": ["name", "url"], "properties": {"name": {"type": "string"}, "url": {"type": "string", "format": "uri"}}})' stage/specification.yml
	# Remove pokemon encounters endpoint which generates files with names > 100 chars.
	# /api/v2/pokemon/{pokemon_id}/encounters has deeply nested inline response schemas
	# (e.g. PokemonEncountersRetrieve200ResponseInnerVersionDetailsInnerEncounterDetailsInnerConditionValuesInner)
	# whose generated doc filenames exceed the tar format's 100-char limit, breaking
	# `gem build` with Gem::Package::TooLongFileName.
	yq -i 'del(.paths."/api/v2/pokemon/{pokemon_id}/encounters")' stage/specification.yml

.PHONY: x-post-init-spec
