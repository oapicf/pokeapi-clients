{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "RegionDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "locations",
      "type": {
        "type": "array",
        "items": "model.LocationSummary"
      },
      "doc": "A list of locations that can be found in this region."
    },
    {
      "name": "main_generation",
      "type": "model.GenerationSummary",
      "doc": "The generation this region was introduced in."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.RegionName"
      },
      "doc": "The name of this resource listed in different languages."
    },
    {
      "name": "pokedexes",
      "type": {
        "type": "array",
        "items": "model.PokedexSummary"
      },
      "doc": "A list of pokédexes that catalogue Pokémon in this region."
    },
    {
      "name": "version_groups",
      "type": {
        "type": "array",
        "items": "model.VersionGroupSummary"
      },
      "doc": "A list of version groups where this region can be visited."
    }
  ]

}
