{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "AbilityDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "is_main_series",
      "type": ["null", "boolean"],
      "doc": "Whether or not this ability originated in the main series of the video games.",
      "default": null
    },
    {
      "name": "generation",
      "type": "model.GenerationSummary",
      "doc": "The generation this ability originated in."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.AbilityName"
      },
      "doc": "The name of this resource listed in different languages."
    },
    {
      "name": "effect_entries",
      "type": {
        "type": "array",
        "items": "model.AbilityEffectText"
      },
      "doc": "The effect of this ability listed in different languages."
    },
    {
      "name": "effect_changes",
      "type": {
        "type": "array",
        "items": "model.AbilityChange"
      },
      "doc": "The list of previous effects this ability has had across version groups."
    },
    {
      "name": "flavor_text_entries",
      "type": {
        "type": "array",
        "items": "model.AbilityFlavorText"
      },
      "doc": "The flavor text of this ability listed in different languages."
    },
    {
      "name": "pokemon",
      "type": {
        "type": "array",
        "items": "model.AbilityPokemonDetail"
      },
      "doc": "A list of Pokémon that could potentially have this ability."
    }
  ]

}
