{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "ItemDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "fling_power",
      "type": ["null", "int"],
      "doc": "The power of the move Fling when used with this item.",
      "default": null
    },
    {
      "name": "fling_effect",
      "type": "model.ItemFlingEffectSummary",
      "doc": "The effect of the move Fling when used with this item."
    },
    {
      "name": "attributes",
      "type": {
        "type": "array",
        "items": "model.ItemAttributeSummary"
      },
      "doc": "A list of attributes this item has."
    },
    {
      "name": "category",
      "type": "model.ItemCategorySummary",
      "doc": "The category of items this item falls into."
    },
    {
      "name": "effect_entries",
      "type": {
        "type": "array",
        "items": "model.ItemEffectText"
      },
      "doc": "The effect of this ability listed in different languages."
    },
    {
      "name": "flavor_text_entries",
      "type": {
        "type": "array",
        "items": "model.ItemFlavorText"
      },
      "doc": "The flavor text of this ability listed in different languages."
    },
    {
      "name": "game_indices",
      "type": {
        "type": "array",
        "items": "model.ItemGameIndex"
      },
      "doc": "A list of game indices relevent to this item by generation."
    },
    {
      "name": "prices",
      "type": {
        "type": "array",
        "items": "model.ItemPrice"
      },
      "doc": "Purchase and sell prices by currency and version group. Prices may be null when the item cannot be bought or sold."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.ItemName"
      },
      "doc": "The name of this item listed in different languages."
    },
    {
      "name": "held_by_pokemon",
      "type": {
        "type": "array",
        "items": "model.PokemonHeldItem"
      },
      "doc": "A list of Pokémon that might be found in the wild holding this item."
    },
    {
      "name": "sprites",
      "type": "model.ItemSprites",
      "doc": "A set of sprites used to depict this item in the game."
    },
    {
      "name": "baby_trigger_for",
      "type": "model.EvolutionChainSummary",
      "doc": "An evolution chain this item requires to produce a bay during mating."
    },
    {
      "name": "machines",
      "type": {
        "type": "array",
        "items": "model.ItemMachine"
      },
      "doc": "A list of the machines related to this item."
    }
  ]

}
