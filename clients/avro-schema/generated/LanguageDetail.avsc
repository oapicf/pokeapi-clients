{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "LanguageDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "official",
      "type": ["null", "boolean"],
      "doc": "Whether or not the games are published in this language.",
      "default": null
    },
    {
      "name": "iso639",
      "type": "string",
      "doc": "The two-letter ISO 639-1 language code. Multiple PokéAPI language records may share this code."
    },
    {
      "name": "iso3166",
      "type": "string",
      "doc": "The two-letter ISO 3166-1 alpha-2 code of the country or region associated with this language record. Multiple PokéAPI language records may share this code."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.LanguageName"
      },
      "doc": "The name of this resource listed in different languages."
    }
  ]

}
