{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "PokedexDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "is_main_series",
      "type": ["null", "boolean"],
      "doc": "Whether or not this Pokédex originated in the main series of the video games.",
      "default": null
    },
    {
      "name": "descriptions",
      "type": {
        "type": "array",
        "items": "model.PokedexDescription"
      },
      "doc": "The description of this resource listed in different languages."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.PokedexName"
      },
      "doc": "The name of this resource listed in different languages."
    },
    {
      "name": "pokemon_entries",
      "type": {
        "type": "array",
        "items": "model.PokemonDexNumber"
      },
      "doc": "A list of Pokémon catalogued in this Pokédex and their indexes."
    },
    {
      "name": "region",
      "type": "model.RegionSummary",
      "doc": "The region this Pokédex catalogues Pokémon for."
    },
    {
      "name": "version_groups",
      "type": {
        "type": "array",
        "items": "model.VersionGroupSummary"
      },
      "doc": "A list of version groups this Pokédex is relevant to."
    }
  ]

}
