{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "GrowthRateDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "formula",
      "type": "string",
      "doc": "The formula used to calculate the rate at which the Pokémon species gains level."
    },
    {
      "name": "descriptions",
      "type": {
        "type": "array",
        "items": "model.GrowthRateDescription"
      },
      "doc": "The descriptions of this characteristic listed in different languages."
    },
    {
      "name": "levels",
      "type": {
        "type": "array",
        "items": "model.Experience"
      },
      "doc": "A list of levels and the amount of experienced needed to atain them based on this growth rate."
    },
    {
      "name": "pokemon_species",
      "type": {
        "type": "array",
        "items": "model.PokemonSpeciesSummary"
      },
      "doc": "A list of Pokémon species that gain levels at this growth rate."
    }
  ]

}
