{
  "namespace": "model",
  "type": "record",
  "doc": "Should have a link to Version Group info but the Circular dependency and compilation order fight eachother and I'm not sure how to add anything other than a hyperlink",
  "name": "VersionDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.VersionName"
      },
      "doc": "The name of this resource listed in different languages."
    },
    {
      "name": "version_group",
      "type": "model.VersionGroupSummary",
      "doc": "The version group this version belongs to."
    }
  ]

}
