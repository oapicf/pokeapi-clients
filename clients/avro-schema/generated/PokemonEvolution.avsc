{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "PokemonEvolution",
  "fields": [
    {
      "name": "version_group",
      "type": "model.VersionGroupSummary",
      "doc": "The version group in which these evolution requirements apply."
    },
    {
      "name": "is_default",
      "type": ["null", "boolean"],
      "doc": "Whether the evolution is considered as the expected evolution in a main series game. Each unique Pokémon variety of a line capable of evolution should have exactly one 'default' evolution. For example, the Meowth species has three default evolutions as there are three distinct varieties it can evolve into: Persian, Alolan Persian, and Perrserker.",
      "default": null
    },
    {
      "name": "item",
      "type": "model.ItemSummary",
      "doc": "The item required to cause evolution this into Pokémon species."
    },
    {
      "name": "trigger",
      "type": "model.EvolutionTriggerSummary",
      "doc": "The type of event that triggers evolution into this Pokémon species."
    },
    {
      "name": "gender",
      "type": ["null", "int"],
      "doc": "The id of the gender of the evolving Pokémon species must be in order to evolve into this Pokémon species.",
      "default": null
    },
    {
      "name": "held_item",
      "type": "model.ItemSummary",
      "doc": "The item the evolving Pokémon species must be holding during the evolution trigger event to evolve into this Pokémon species."
    },
    {
      "name": "known_move",
      "type": "model.PokemonEvolutionKnownMove",
      "doc": ""
    },
    {
      "name": "known_move_type",
      "type": "model.PokemonEvolutionKnownMove",
      "doc": ""
    },
    {
      "name": "location",
      "type": "model.LocationSummary",
      "doc": "The location the evolution must be triggered at."
    },
    {
      "name": "min_level",
      "type": ["null", "int"],
      "doc": "The minimum required level of the evolving Pokémon species to evolve into this Pokémon species.",
      "default": null
    },
    {
      "name": "min_happiness",
      "type": ["null", "int"],
      "doc": "The minimum required level of happiness the evolving Pokémon species to evolve into this Pokémon species.",
      "default": null
    },
    {
      "name": "min_beauty",
      "type": ["null", "int"],
      "doc": "The minimum required level of beauty the evolving Pokémon species to evolve into this Pokémon species.",
      "default": null
    },
    {
      "name": "min_affection",
      "type": ["null", "int"],
      "doc": "The minimum required level of affection the evolving Pokémon species to evolve into this Pokémon species.",
      "default": null
    },
    {
      "name": "near_special_rock",
      "type": ["null", "boolean"],
      "doc": "Whether or not you need to be near a Moss Rock or Icy Rock to evolve into this Pokémon species.",
      "default": null
    },
    {
      "name": "needs_multiplayer",
      "type": ["null", "boolean"],
      "doc": "Whether or not multiplayer link play is needed to evolve into this Pokémon species (e.g. Union Circle).",
      "default": null
    },
    {
      "name": "needs_overworld_rain",
      "type": ["null", "boolean"],
      "doc": "Whether or not it must be raining in the overworld to cause evolution this Pokémon species.",
      "default": null
    },
    {
      "name": "party_species",
      "type": "model.PokemonSpeciesSummary",
      "doc": "The Pokémon species that must be in the players party in order for the evolving Pokémon species to evolve into this Pokémon species."
    },
    {
      "name": "party_type",
      "type": "model.TypeSummary",
      "doc": "The player must have a Pokémon of this type in their party during the evolution trigger event in order for the evolving Pokémon species to evolve into this Pokémon species."
    },
    {
      "name": "relative_physical_stats",
      "type": ["null", "int"],
      "doc": "The required relation between the Pokémon's Attack and Defense stats. 1 means Attack > Defense. 0 means Attack = Defense. -1 means Attack < Defense.",
      "default": null
    },
    {
      "name": "time_of_day",
      "type": ["null", "string"],
      "doc": "The required time of day. Day or night.",
      "default": null
    },
    {
      "name": "trade_species",
      "type": "model.PokemonSpeciesSummary",
      "doc": "Pokémon species for which this one must be traded."
    },
    {
      "name": "turn_upside_down",
      "type": ["null", "boolean"],
      "doc": "Whether or not the 3DS needs to be turned upside-down as this Pokémon levels up.",
      "default": null
    },
    {
      "name": "region",
      "type": "model.RegionSummary",
      "doc": "The required region in which this evolution can occur."
    },
    {
      "name": "required_pokemon_form",
      "type": "model.PokemonFormSummary",
      "doc": "The Pokémon form required before evolving, or null if unrestricted."
    },
    {
      "name": "evolved_pokemon_form",
      "type": "model.PokemonFormSummary",
      "doc": "The Pokémon form produced by this evolution, or null if unspecified."
    },
    {
      "name": "used_move",
      "type": "model.MoveSummary",
      "doc": "The move that must be used by the evolving Pokémon species during the evolution trigger event in order to evolve into this Pokémon species."
    },
    {
      "name": "min_move_count",
      "type": ["null", "int"],
      "doc": "The minimum number of times a move must be used in order to evolve into this Pokémon species.",
      "default": null
    },
    {
      "name": "min_steps",
      "type": ["null", "int"],
      "doc": "The minimum number of steps that must be taken in order to evolve into this Pokémon species.",
      "default": null
    },
    {
      "name": "min_damage_taken",
      "type": ["null", "int"],
      "doc": "The minimum amount of damage taken during the evolution trigger event in order to evolve into this Pokémon species.",
      "default": null
    },
    {
      "name": "allowed_natures",
      "type": {
        "type": "array",
        "items": "model.NatureSummary"
      },
      "doc": "The natures that allow this evolution, or null if unrestricted."
    },
    {
      "name": "condition_expression",
      "type": "model.EvolutionConditionExpression",
      "doc": "An additional evolution condition expressed in reverse Polish notation, or null if none."
    }
  ]

}
