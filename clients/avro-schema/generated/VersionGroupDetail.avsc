{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "VersionGroupDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "order",
      "type": ["null", "int"],
      "doc": "Order for sorting. Almost by date of release, except similar versions are grouped together.",
      "default": null
    },
    {
      "name": "generation",
      "type": "model.GenerationSummary",
      "doc": "The generation this version was introduced in."
    },
    {
      "name": "move_learn_methods",
      "type": {
        "type": "array",
        "items": "model.MoveLearnMethodSummary"
      },
      "doc": "A list of methods in which Pokémon can learn moves in this version group."
    },
    {
      "name": "pokedexes",
      "type": {
        "type": "array",
        "items": "model.PokedexSummary"
      },
      "doc": "A list of Pokédexes introduces in this version group."
    },
    {
      "name": "regions",
      "type": {
        "type": "array",
        "items": "model.RegionSummary"
      },
      "doc": "A list of regions that can be visited in this version group."
    },
    {
      "name": "versions",
      "type": {
        "type": "array",
        "items": "model.VersionSummary"
      },
      "doc": "The versions this version group owns."
    }
  ]

}
