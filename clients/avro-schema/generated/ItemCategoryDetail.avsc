  "name": "ItemCategoryDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "items",
      "type": {
        "type": "array",
        "items": "model.ItemSummary"
      },
      "doc": "A list of items that are a part of this category."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.ItemCategoryName"
      },
      "doc": "The name of this item category listed in different languages."
