{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "GenderDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "pokemon_species_details",
      "type": {
        "type": "array",
        "items": "model.GenderPokemonSpecies"
      },
      "doc": "A list of Pokémon species that can be this gender and how likely it is that they will be."
    },
    {
      "name": "required_for_evolution",
      "type": {
        "type": "array",
        "items": "model.PokemonSpeciesSummary"
      },
      "doc": "A list of Pokémon species that required this gender in order for a Pokémon to evolve into them."
    }
  ]

}
