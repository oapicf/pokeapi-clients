{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "PokemonShapeDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "awesome_names",
      "type": {
        "type": "array",
        "items": "model.PokemonShapeAwesomeName"
      },
      "doc": "The \"scientific\" name of this Pokémon shape listed in different languages."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.PokemonShapeName"
      },
      "doc": "The name of this resource listed in different languages."
    },
    {
      "name": "pokemon_species",
      "type": {
        "type": "array",
        "items": "model.PokemonSpeciesSummary"
      },
      "doc": "A list of the Pokémon species that have this shape."
    }
  ]

}
