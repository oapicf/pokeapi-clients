{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "PokemonSpeciesDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "order",
      "type": ["null", "int"],
      "doc": "The order in which species should be sorted. Based on National Dex order, except families are grouped together and sorted by stage.",
      "default": null
    },
    {
      "name": "gender_rate",
      "type": ["null", "int"],
      "doc": "The chance of this Pokémon being female, in eighths; or -1 for genderless.",
      "default": null
    },
    {
      "name": "capture_rate",
      "type": ["null", "int"],
      "doc": "The base capture rate; up to 255. The higher the number, the easier the catch.",
      "default": null
    },
    {
      "name": "base_happiness",
      "type": ["null", "int"],
      "doc": "The happiness when caught by a normal Pokéball; up to 255. The higher the number, the happier the Pokémon.",
      "default": null
    },
    {
      "name": "is_baby",
      "type": ["null", "boolean"],
      "doc": "Whether or not this is a baby Pokémon.",
      "default": null
    },
    {
      "name": "is_legendary",
      "type": ["null", "boolean"],
      "doc": "Whether or not this is a legendary Pokémon.",
      "default": null
    },
    {
      "name": "is_mythical",
      "type": ["null", "boolean"],
      "doc": "Whether or not this is a mythical Pokémon.",
      "default": null
    },
    {
      "name": "hatch_counter",
      "type": ["null", "int"],
      "doc": "Initial hatch counter: one must walk Y × (hatch_counter + 1) steps before this Pokémon's egg hatches, unless utilizing bonuses like Flame Body's. Y varies per generation. In Generations II, III, and VII, Egg cycles are 256 steps long. In Generation IV, Egg cycles are 255 steps long. In Pokémon Brilliant Diamond and Shining Pearl, Egg cycles are also 255 steps long, but are shorter on special dates. In Generations V and VI, Egg cycles are 257 steps long. In Pokémon Sword and Shield, and in Pokémon Scarlet and Violet, Egg cycles are 128 steps long.",
      "default": null
    },
    {
      "name": "has_gender_differences",
      "type": ["null", "boolean"],
      "doc": "Whether or not this Pokémon has visual gender differences.",
      "default": null
    },
    {
      "name": "forms_switchable",
      "type": ["null", "boolean"],
      "doc": "Whether or not this Pokémon has multiple forms and can switch between them.",
      "default": null
    },
    {
      "name": "growth_rate",
      "type": "model.GrowthRateSummary",
      "doc": "The rate at which this Pokémon species gains levels."
    },
    {
      "name": "pokedex_numbers",
      "type": {
        "type": "array",
        "items": "model.PokemonDexEntry"
      },
      "doc": "A list of Pokedexes and the indexes reserved within them for this Pokémon species."
    },
    {
      "name": "egg_groups",
      "type": {
        "type": "array",
        "items": "model.EggGroupSummary"
      },
      "doc": "A list of egg groups this Pokémon species is a member of."
    },
    {
      "name": "color",
      "type": "model.PokemonColorSummary",
      "doc": "The color of this Pokémon for Pokédex search."
    },
    {
      "name": "shape",
      "type": "model.PokemonShapeSummary",
      "doc": "The shape of this Pokémon for Pokédex search."
    },
    {
      "name": "evolves_from_species",
      "type": "model.PokemonSpeciesSummary",
      "doc": "The Pokémon species that evolves into this Pokemon_species."
    },
    {
      "name": "evolution_chain",
      "type": "model.EvolutionChainSummary",
      "doc": "The evolution chain this Pokémon species is a member of."
    },
    {
      "name": "habitat",
      "type": "model.PokemonHabitatSummary",
      "doc": "The habitat this Pokémon species can be encountered in."
    },
    {
      "name": "generation",
      "type": "model.GenerationSummary",
      "doc": "The generation this Pokémon species was introduced in."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.PokemonSpeciesName"
      },
      "doc": "The name of this resource listed in different languages."
    },
    {
      "name": "pal_park_encounters",
      "type": {
        "type": "array",
        "items": "model.PokemonSpeciesPalParkEncounter"
      },
      "doc": "A list of encounters that can be had with this Pokémon species in pal park."
    },
    {
      "name": "form_descriptions",
      "type": {
        "type": "array",
        "items": "model.PokemonSpeciesDescription"
      },
      "doc": "Descriptions of different forms Pokémon take on within the Pokémon species."
    },
    {
      "name": "flavor_text_entries",
      "type": {
        "type": "array",
        "items": "model.PokemonSpeciesFlavorText"
      },
      "doc": "A list of flavor text entries for this Pokémon species."
    },
    {
      "name": "genera",
      "type": {
        "type": "array",
        "items": "model.PokemonSpeciesGenus"
      },
      "doc": "The genus of this Pokémon species listed in multiple languages."
    },
    {
      "name": "varieties",
      "type": {
        "type": "array",
        "items": "model.PokemonSpeciesVariety"
      },
      "doc": "A list of the Pokémon that exist within this Pokémon species."
    }
  ]

}
