{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "LocationDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "region",
      "type": "model.RegionSummary",
      "doc": "The region this location can be found in."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.LocationName"
      },
      "doc": "The name of this resource listed in different languages."
    },
    {
      "name": "game_indices",
      "type": {
        "type": "array",
        "items": "model.LocationGameIndex"
      },
      "doc": "A list of game indices relevent to this location by generation."
    },
    {
      "name": "areas",
      "type": {
        "type": "array",
        "items": "model.LocationAreaSummary"
      },
      "doc": "Areas that can be found within this location."
    }
  ]

}
