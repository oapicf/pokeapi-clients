{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "GenerationDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "abilities",
      "type": {
        "type": "array",
        "items": "model.AbilitySummary"
      },
      "doc": "A list of abilities that were introduced in this generation."
    },
    {
      "name": "main_region",
      "type": "model.RegionSummary",
      "doc": "The main region travelled in this generation."
    },
    {
      "name": "moves",
      "type": {
        "type": "array",
        "items": "model.MoveSummary"
      },
      "doc": "A list of moves that were introduced in this generation."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.GenerationName"
      },
      "doc": "The name of this resource listed in different languages."
    },
    {
      "name": "pokemon_species",
      "type": {
        "type": "array",
        "items": "model.PokemonSpeciesSummary"
      },
      "doc": "A list of Pokémon species that were introduced in this generation."
    },
    {
      "name": "types",
      "type": {
        "type": "array",
        "items": "model.TypeSummary"
      },
      "doc": "A list of types that were introduced in this generation."
    },
    {
      "name": "version_groups",
      "type": {
        "type": "array",
        "items": "model.VersionGroupSummary"
      },
      "doc": "A list of version groups that were introduced in this generation."
    }
  ]

}
