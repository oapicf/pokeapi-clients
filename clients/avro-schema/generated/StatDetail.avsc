{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "StatDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "game_index",
      "type": "int",
      "doc": "ID the games use for this stat."
    },
    {
      "name": "is_battle_only",
      "type": ["null", "boolean"],
      "doc": "Whether this stat only exists within a battle.",
      "default": null
    },
    {
      "name": "affecting_moves",
      "type": "model.StatAffectingMoves",
      "doc": "A detail of moves which affect this stat positively or negatively."
    },
    {
      "name": "affecting_natures",
      "type": "model.StatAffectingNatures",
      "doc": "A detail of natures which affect this stat positively or negatively."
    },
    {
      "name": "affecting_items",
      "type": {
        "type": "array",
        "items": "model.ItemSummary"
      },
      "doc": "Items that affect this stat, such as vitamins and battle items."
    },
    {
      "name": "characteristics",
      "type": {
        "type": "array",
        "items": "model.CharacteristicSummary"
      },
      "doc": "A list of characteristics that are set on a Pokémon when its highest base stat is this stat."
    },
    {
      "name": "move_damage_class",
      "type": "model.MoveDamageClassSummary",
      "doc": "The class of damage this stat is directly related to."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.StatName"
      },
      "doc": "The name of this resource listed in different languages."
    }
  ]

}
