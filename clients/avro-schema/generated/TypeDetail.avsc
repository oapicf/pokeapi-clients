{
  "namespace": "model",
  "type": "record",
  "doc": "Serializer for the Type resource",
  "name": "TypeDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "name",
      "type": "string",
      "doc": "The name for this resource."
    },
    {
      "name": "damage_relations",
      "type": "model.TypeRelationships",
      "doc": "A detail of how effective this type is toward others and vice versa."
    },
    {
      "name": "past_damage_relations",
      "type": {
        "type": "array",
        "items": "model.TypePastRelationships"
      },
      "doc": "A list of details of how effective this type was toward others and vice versa in previous generations"
    },
    {
      "name": "game_indices",
      "type": {
        "type": "array",
        "items": "model.TypeGameIndex"
      },
      "doc": "A list of game indices relevent to this item by generation."
    },
    {
      "name": "generation",
      "type": "model.GenerationSummary",
      "doc": "The generation this type was introduced in."
    },
    {
      "name": "move_damage_class",
      "type": "model.MoveDamageClassSummary",
      "doc": "The class of damage inflicted by this type."
    },
    {
      "name": "names",
      "type": {
        "type": "array",
        "items": "model.TypeName"
      },
      "doc": "The name of this resource listed in different languages."
    },
    {
      "name": "pokemon",
      "type": {
        "type": "array",
        "items": "model.TypePokemon"
      },
      "doc": "A list of details of Pokémon that have this type."
    },
    {
      "name": "moves",
      "type": {
        "type": "array",
        "items": "model.MoveSummary"
      },
      "doc": "A list of moves that have this type."
    },
    {
      "name": "sprites",
      "type": {
        "type": "map",
        "items": "model.map"
      },
      "doc": "Type icons grouped by generation and game, with name_icon and symbol_icon URLs. Unavailable icons are null."
    }
  ]

}
