{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "MoveMeta",
  "fields": [
    {
      "name": "ailment",
      "type": "model.MoveMetaAilmentSummary",
      "doc": "The status ailment this move inflicts on its target."
    },
    {
      "name": "category",
      "type": "model.MoveMetaCategorySummary",
      "doc": "The category of move this move falls under, e.g. damage or ailment."
    },
    {
      "name": "min_hits",
      "type": ["null", "int"],
      "doc": "The minimum number of times this move hits. Null if it always only hits once.",
      "default": null
    },
    {
      "name": "max_hits",
      "type": ["null", "int"],
      "doc": "The maximum number of times this move hits. Null if it always only hits once.",
      "default": null
    },
    {
      "name": "min_turns",
      "type": ["null", "int"],
      "doc": "The minimum number of turns this move continues to take effect. Null if it always only lasts one turn.",
      "default": null
    },
    {
      "name": "max_turns",
      "type": ["null", "int"],
      "doc": "The maximum number of turns this move continues to take effect. Null if it always only lasts one turn.",
      "default": null
    },
    {
      "name": "drain",
      "type": ["null", "int"],
      "doc": "HP drain (if positive) or Recoil damage (if negative), in percent of damage done.",
      "default": null
    },
    {
      "name": "healing",
      "type": ["null", "int"],
      "doc": "The amount of hp gained by the attacking Pokemon, in percent of it's maximum HP.",
      "default": null
    },
    {
      "name": "crit_rate",
      "type": ["null", "int"],
      "doc": "Critical hit rate bonus.",
      "default": null
    },
    {
      "name": "ailment_chance",
      "type": ["null", "int"],
      "doc": "The likelihood this attack will cause an ailment.",
      "default": null
    },
    {
      "name": "flinch_chance",
      "type": ["null", "int"],
      "doc": "The likelihood this attack will cause the target Pokémon to flinch.",
      "default": null
    },
    {
      "name": "stat_chance",
      "type": ["null", "int"],
      "doc": "The likelihood this attack will cause a stat change in the target Pokémon.",
      "default": null
    }
  ]

}
