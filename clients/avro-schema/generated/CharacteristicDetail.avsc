{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "CharacteristicDetail",
  "fields": [
    {
      "name": "id",
      "type": "int",
      "doc": "The identifier for this resource."
    },
    {
      "name": "gene_modulo",
      "type": "int",
      "doc": "The remainder of the highest stat/IV divided by 5."
    },
    {
      "name": "possible_values",
      "type": {
        "type": "array",
        "items": "int"
      },
      "doc": "The possible values of the highest stat that would result in a Pokémon recieving this characteristic when divided by 5."
    },
    {
      "name": "highest_stat",
      "type": "model.StatSummary",
      "doc": "The stat which results in this characteristic."
    },
    {
      "name": "descriptions",
      "type": {
        "type": "array",
        "items": "model.CharacteristicDescription"
      },
      "doc": "The descriptions of this characteristic listed in different languages."
    }
  ]

}
