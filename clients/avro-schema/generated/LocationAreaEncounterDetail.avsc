{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "LocationAreaEncounterDetail",
  "fields": [
    {
      "name": "min_level",
      "type": "int",
      "doc": "The lowest level the Pokémon could be encountered at."
    },
    {
      "name": "max_level",
      "type": "int",
      "doc": "The highest level the Pokémon could be encountered at."
    },
    {
      "name": "chance",
      "type": ["int", "null"],
      "doc": "Percent chance that this encounter will occur.",
      "default": 0
    },
    {
      "name": "method",
      "type": ["null", "model.EncounterMethodSummary"],
      "doc": "The method by which this encounter happens.",
      "default": null
    },
    {
      "name": "condition_values",
      "type": {
        "type": "array",
        "items": "model.EncounterConditionValueSummary"
      },
      "doc": "A list of condition values that must be in effect for this encounter to occur."
    },
    {
      "name": "pokemon_details",
      "type": "model.EncounterPokemonDetail",
      "doc": "Additional properties of the encountered Pokémon, or null if unspecified."
    }
  ]

}
