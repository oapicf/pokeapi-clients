{
  "namespace": "model",
  "type": "record",
  "doc": "",
  "name": "MoveChange",
  "fields": [
    {
      "name": "accuracy",
      "type": ["null", "int"],
      "doc": "The percent value of how likely this move is to be successful.",
      "default": null
    },
    {
      "name": "power",
      "type": ["null", "int"],
      "doc": "The base power before the listed version group, or null if power did not change.",
      "default": null
    },
    {
      "name": "pp",
      "type": ["null", "int"],
      "doc": "Power points. The number of times this move can be used.",
      "default": null
    },
    {
      "name": "effect_chance",
      "type": "int",
      "doc": "The percent value of how likely it is this moves effect will take effect."
    },
    {
      "name": "effect_entries",
      "type": {
        "type": "array",
        "items": "model.MoveEffectEffectText"
      },
      "doc": "The effect of this move listed in different languages."
    },
    {
      "name": "type",
      "type": "model.TypeSummary",
      "doc": "The elemental type of this move."
    },
    {
      "name": "version_group",
      "type": "model.VersionGroupSummary",
      "doc": "The version group in which these move stat values were in effect."
    }
  ]

}
