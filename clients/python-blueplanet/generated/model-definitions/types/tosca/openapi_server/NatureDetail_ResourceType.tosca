"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server NatureDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a NatureDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  BerryFlavorSummary = openapi_server.resourceTypes.BerryFlavorSummary
  NatureBattleStylePreference = openapi_server.resourceTypes.NatureBattleStylePreference
  NatureName = openapi_server.resourceTypes.NatureName
  NaturePokeathlonStat = openapi_server.resourceTypes.NaturePokeathlonStat
  StatSummary = openapi_server.resourceTypes.StatSummary
}
resourceTypes {

  NatureDetail {
    title = NatureDetail
    description = NatureDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        decreased_stat {
          type = StatSummary
          description = "The stat decreased by 10% in Pokémon with this nature."
          optional = true
        }
        increased_stat {
          type = StatSummary
          description = "The stat increased by 10% in Pokémon with this nature."
          optional = true
        }
        likes_flavor {
          type = BerryFlavorSummary
          description = "The flavor liked by Pokémon with this nature."
          optional = true
        }
        hates_flavor {
          type = BerryFlavorSummary
          description = "The flavor hated by Pokémon with this nature."
          optional = true
        }
        pokeathlon_stat_changes {
          type = array
          items.type = NaturePokeathlonStat
          description = "A list of Pokéathlon stats this nature effects and how much it effects them."
          optional = true
        }
        move_battle_style_preferences {
          type = array
          items.type = NatureBattleStylePreference
          description = "A list of battle styles and how likely a Pokémon with this nature is to use them in the Battle Palace or Battle Tent."
          optional = true
        }
        names {
          type = array
          items.type = NatureName
          description = "The name of this resource listed in different languages."
          optional = true
        }
    }
  }
}

serviceTemplates {

  NatureDetail {
    title = NatureDetail
    description = NatureDetail
    implements = openapi_server.resourceTypes.NatureDetail

  }
}
