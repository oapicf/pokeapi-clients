"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LocationAreaDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a LocationAreaDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  LocationAreaEncounterRate = openapi_server.resourceTypes.LocationAreaEncounterRate
  LocationAreaName = openapi_server.resourceTypes.LocationAreaName
  LocationAreaPokemonEncounter = openapi_server.resourceTypes.LocationAreaPokemonEncounter
  LocationSummary = openapi_server.resourceTypes.LocationSummary
}
resourceTypes {

  LocationAreaDetail {
    title = LocationAreaDetail
    description = LocationAreaDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        game_index {
          type =  integer
          description = "The internal id of an API resource within game data."
          optional = true
        }
        encounter_method_rates {
          type = array
          items.type = LocationAreaEncounterRate
          description = "A list of methods in which Pokémon may be encountered in this area and how likely the method will occur depending on the version of the game."
          optional = true
        }
        location {
          type = LocationSummary
          description = "The region this location area can be found in."
          optional = true
        }
        names {
          type = array
          items.type = LocationAreaName
          description = "The name of this resource listed in different languages."
          optional = true
        }
        pokemon_encounters {
          type = array
          items.type = LocationAreaPokemonEncounter
          description = "A list of Pokémon that can be encountered in this area along with version specific details about the encounter."
          optional = true
        }
    }
  }
}

serviceTemplates {

  LocationAreaDetail {
    title = LocationAreaDetail
    description = LocationAreaDetail
    implements = openapi_server.resourceTypes.LocationAreaDetail

  }
}
