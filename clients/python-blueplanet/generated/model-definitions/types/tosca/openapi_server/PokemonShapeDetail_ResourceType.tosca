"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PokemonShapeDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a PokemonShapeDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  PokemonShapeAwesomeName = openapi_server.resourceTypes.PokemonShapeAwesomeName
  PokemonShapeName = openapi_server.resourceTypes.PokemonShapeName
  PokemonSpeciesSummary = openapi_server.resourceTypes.PokemonSpeciesSummary
}
resourceTypes {

  PokemonShapeDetail {
    title = PokemonShapeDetail
    description = PokemonShapeDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        awesome_names {
          type = array
          items.type = PokemonShapeAwesomeName
          description = "The \&quot;scientific\&quot; name of this Pokémon shape listed in different languages."
          optional = true
        }
        names {
          type = array
          items.type = PokemonShapeName
          description = "The name of this resource listed in different languages."
          optional = true
        }
        pokemon_species {
          type = array
          items.type = PokemonSpeciesSummary
          description = "A list of the Pokémon species that have this shape."
          optional = true
        }
    }
  }
}

serviceTemplates {

  PokemonShapeDetail {
    title = PokemonShapeDetail
    description = PokemonShapeDetail
    implements = openapi_server.resourceTypes.PokemonShapeDetail

  }
}
