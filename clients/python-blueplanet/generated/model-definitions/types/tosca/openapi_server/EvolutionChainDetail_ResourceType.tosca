"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server EvolutionChainDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a EvolutionChainDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  EvolutionChainLink = openapi_server.resourceTypes.EvolutionChainLink
  ItemSummary = openapi_server.resourceTypes.ItemSummary
}
resourceTypes {

  EvolutionChainDetail {
    title = EvolutionChainDetail
    description = EvolutionChainDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        baby_trigger_item {
          type = ItemSummary
          description = "The item that a Pokémon would be holding when mating that would trigger the egg hatching a baby Pokémon rather than a basic Pokémon."
          optional = true
        }
        chain {
          type = EvolutionChainLink
          description = "The base chain link object. Each link contains evolution details for a Pokémon in the chain. Each link references the next Pokémon in the natural evolution order."
          optional = true
        }
    }
  }
}

serviceTemplates {

  EvolutionChainDetail {
    title = EvolutionChainDetail
    description = EvolutionChainDetail
    implements = openapi_server.resourceTypes.EvolutionChainDetail

  }
}
