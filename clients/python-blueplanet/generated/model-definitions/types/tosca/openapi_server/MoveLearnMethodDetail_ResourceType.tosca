"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server MoveLearnMethodDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a MoveLearnMethodDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  MoveLearnMethodDescription = openapi_server.resourceTypes.MoveLearnMethodDescription
  MoveLearnMethodName = openapi_server.resourceTypes.MoveLearnMethodName
  VersionGroupSummary = openapi_server.resourceTypes.VersionGroupSummary
}
resourceTypes {

  MoveLearnMethodDetail {
    title = MoveLearnMethodDetail
    description = MoveLearnMethodDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        names {
          type = array
          items.type = MoveLearnMethodName
          description = "The name of this resource listed in different languages."
          optional = true
        }
        descriptions {
          type = array
          items.type = MoveLearnMethodDescription
          description = "The description of this resource listed in different languages."
          optional = true
        }
        version_groups {
          type = array
          items.type = VersionGroupSummary
          description = "A list of version groups where moves can be learned through this method."
          optional = true
        }
    }
  }
}

serviceTemplates {

  MoveLearnMethodDetail {
    title = MoveLearnMethodDetail
    description = MoveLearnMethodDetail
    implements = openapi_server.resourceTypes.MoveLearnMethodDetail

  }
}
