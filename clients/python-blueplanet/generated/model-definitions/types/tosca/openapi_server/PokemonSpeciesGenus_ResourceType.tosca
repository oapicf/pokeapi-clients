"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PokemonSpeciesGenus"
package     = openapi_server
version     = "1.0"
description = "Defines a PokemonSpeciesGenus"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  LanguageSummary = openapi_server.resourceTypes.LanguageSummary
}
resourceTypes {

  PokemonSpeciesGenus {
    title = PokemonSpeciesGenus
    description = PokemonSpeciesGenus
    derivedFrom = Root
    properties {
        genus {
          type =  string
          description = "The localized genus for the referenced Pokémon species"
          optional = true
        }
        language {
          type = LanguageSummary
          description = "The language this genus is in."
          optional = true
        }
    }
  }
}

serviceTemplates {

  PokemonSpeciesGenus {
    title = PokemonSpeciesGenus
    description = PokemonSpeciesGenus
    implements = openapi_server.resourceTypes.PokemonSpeciesGenus

  }
}
