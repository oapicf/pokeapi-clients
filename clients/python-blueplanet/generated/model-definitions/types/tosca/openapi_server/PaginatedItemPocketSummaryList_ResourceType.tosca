"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PaginatedItemPocketSummaryList"
package     = openapi_server
version     = "1.0"
description = "Defines a PaginatedItemPocketSummaryList"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  ItemPocketSummary = openapi_server.resourceTypes.ItemPocketSummary
}
resourceTypes {

  PaginatedItemPocketSummaryList {
    title = PaginatedItemPocketSummaryList
    description = PaginatedItemPocketSummaryList
    derivedFrom = Root
    properties {
        count {
          type =  integer
          description = "The total number of resources available from this API."
          optional = true
        }
        next {
          type =  string
          description = "The URL for the next page in the list, or null if there is no next page."
          optional = false
        }
        previous {
          type =  string
          description = "The URL for the previous page in the list, or null if there is no previous page."
          optional = false
        }
        results {
          type = array
          items.type = ItemPocketSummary
          description = "A list of API resources on this page."
          optional = true
        }
    }
  }
}

serviceTemplates {

  PaginatedItemPocketSummaryList {
    title = PaginatedItemPocketSummaryList
    description = PaginatedItemPocketSummaryList
    implements = openapi_server.resourceTypes.PaginatedItemPocketSummaryList

  }
}
