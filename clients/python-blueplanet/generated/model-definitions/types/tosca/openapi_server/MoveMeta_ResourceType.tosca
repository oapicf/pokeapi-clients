"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server MoveMeta"
package     = openapi_server
version     = "1.0"
description = "Defines a MoveMeta"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  MoveMetaAilmentSummary = openapi_server.resourceTypes.MoveMetaAilmentSummary
  MoveMetaCategorySummary = openapi_server.resourceTypes.MoveMetaCategorySummary
}
resourceTypes {

  MoveMeta {
    title = MoveMeta
    description = MoveMeta
    derivedFrom = Root
    properties {
        ailment {
          type = MoveMetaAilmentSummary
          description = "The status ailment this move inflicts on its target."
          optional = true
        }
        category {
          type = MoveMetaCategorySummary
          description = "The category of move this move falls under, e.g. damage or ailment."
          optional = true
        }
        min_hits {
          type =  integer
          description = "The minimum number of times this move hits. Null if it always only hits once."
          optional = false
        }
        max_hits {
          type =  integer
          description = "The maximum number of times this move hits. Null if it always only hits once."
          optional = false
        }
        min_turns {
          type =  integer
          description = "The minimum number of turns this move continues to take effect. Null if it always only lasts one turn."
          optional = false
        }
        max_turns {
          type =  integer
          description = "The maximum number of turns this move continues to take effect. Null if it always only lasts one turn."
          optional = false
        }
        drain {
          type =  integer
          description = "HP drain (if positive) or Recoil damage (if negative), in percent of damage done."
          optional = false
        }
        healing {
          type =  integer
          description = "The amount of hp gained by the attacking Pokemon, in percent of it&#39;s maximum HP."
          optional = false
        }
        crit_rate {
          type =  integer
          description = "Critical hit rate bonus."
          optional = false
        }
        ailment_chance {
          type =  integer
          description = "The likelihood this attack will cause an ailment."
          optional = false
        }
        flinch_chance {
          type =  integer
          description = "The likelihood this attack will cause the target Pokémon to flinch."
          optional = false
        }
        stat_chance {
          type =  integer
          description = "The likelihood this attack will cause a stat change in the target Pokémon."
          optional = false
        }
    }
  }
}

serviceTemplates {

  MoveMeta {
    title = MoveMeta
    description = MoveMeta
    implements = openapi_server.resourceTypes.MoveMeta

  }
}
