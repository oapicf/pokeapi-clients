"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PokeathlonStatDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a PokeathlonStatDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  PokeathlonStatAffectingNatures = openapi_server.resourceTypes.PokeathlonStatAffectingNatures
  PokeathlonStatName = openapi_server.resourceTypes.PokeathlonStatName
}
resourceTypes {

  PokeathlonStatDetail {
    title = PokeathlonStatDetail
    description = PokeathlonStatDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        affecting_natures {
          type = PokeathlonStatAffectingNatures
          description = "A detail of natures which affect this Pokéathlon stat positively or negatively."
          optional = true
        }
        names {
          type = array
          items.type = PokeathlonStatName
          description = "The name of this resource listed in different languages."
          optional = true
        }
    }
  }
}

serviceTemplates {

  PokeathlonStatDetail {
    title = PokeathlonStatDetail
    description = PokeathlonStatDetail
    implements = openapi_server.resourceTypes.PokeathlonStatDetail

  }
}
