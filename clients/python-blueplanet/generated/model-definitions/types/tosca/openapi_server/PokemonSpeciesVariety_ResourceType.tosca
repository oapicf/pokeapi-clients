"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PokemonSpeciesVariety"
package     = openapi_server
version     = "1.0"
description = "Defines a PokemonSpeciesVariety"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  PokemonSummary = openapi_server.resourceTypes.PokemonSummary
}
resourceTypes {

  PokemonSpeciesVariety {
    title = PokemonSpeciesVariety
    description = PokemonSpeciesVariety
    derivedFrom = Root
    properties {
        is_default {
          type =  boolean
          description = "Whether this variety is the default variety."
          optional = true
        }
        pokemon {
          type = PokemonSummary
          description = "The Pokémon variety."
          optional = true
        }
    }
  }
}

serviceTemplates {

  PokemonSpeciesVariety {
    title = PokemonSpeciesVariety
    description = PokemonSpeciesVariety
    implements = openapi_server.resourceTypes.PokemonSpeciesVariety

  }
}
