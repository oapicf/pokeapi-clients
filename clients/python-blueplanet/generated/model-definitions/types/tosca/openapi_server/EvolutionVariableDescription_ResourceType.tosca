"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server EvolutionVariableDescription"
package     = openapi_server
version     = "1.0"
description = "Defines a EvolutionVariableDescription"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  LanguageSummary = openapi_server.resourceTypes.LanguageSummary
}
resourceTypes {

  EvolutionVariableDescription {
    title = EvolutionVariableDescription
    description = EvolutionVariableDescription
    derivedFrom = Root
    properties {
        description {
          type =  string
          description = "The localized description for an API resource in a specific language."
          optional = false
        }
        language {
          type = LanguageSummary
          description = "The language this name is in."
          optional = true
        }
    }
  }
}

serviceTemplates {

  EvolutionVariableDescription {
    title = EvolutionVariableDescription
    description = EvolutionVariableDescription
    implements = openapi_server.resourceTypes.EvolutionVariableDescription

  }
}
