"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server MoveEffectChange"
package     = openapi_server
version     = "1.0"
description = "Defines a MoveEffectChange"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  MoveEffectChangeEffectText = openapi_server.resourceTypes.MoveEffectChangeEffectText
  VersionGroupSummary = openapi_server.resourceTypes.VersionGroupSummary
}
resourceTypes {

  MoveEffectChange {
    title = MoveEffectChange
    description = MoveEffectChange
    derivedFrom = Root
    properties {
        version_group {
          type = VersionGroupSummary
          description = "The version group in which the previous effect of this ability originated."
          optional = true
        }
        effect_entries {
          type = array
          items.type = MoveEffectChangeEffectText
          description = "The previous effect of this ability listed in different languages."
          optional = true
        }
    }
  }
}

serviceTemplates {

  MoveEffectChange {
    title = MoveEffectChange
    description = MoveEffectChange
    implements = openapi_server.resourceTypes.MoveEffectChange

  }
}
