"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server AbilityPokemonDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a AbilityPokemonDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  PokemonSummary = openapi_server.resourceTypes.PokemonSummary
}
resourceTypes {

  AbilityPokemonDetail {
    title = AbilityPokemonDetail
    description = AbilityPokemonDetail
    derivedFrom = Root
    properties {
        is_hidden {
          type =  boolean
          description = "Whether or not this a hidden ability for the referenced Pokémon."
          optional = false
        }
        slot {
          type =  integer
          description = "Pokémon have 3 ability &#39;slots&#39; which hold references to possible abilities they could have. This is the slot of this ability for the referenced pokemon."
          optional = true
        }
        pokemon {
          type = PokemonSummary
          description = "The Pokémon this ability could belong to."
          optional = true
        }
    }
  }
}

serviceTemplates {

  AbilityPokemonDetail {
    title = AbilityPokemonDetail
    description = AbilityPokemonDetail
    implements = openapi_server.resourceTypes.AbilityPokemonDetail

  }
}
