"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PaginatedContestEffectSummaryList"
package     = openapi_server
version     = "1.0"
description = "Defines a PaginatedContestEffectSummaryList"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  ContestEffectSummary = openapi_server.resourceTypes.ContestEffectSummary
}
resourceTypes {

  PaginatedContestEffectSummaryList {
    title = PaginatedContestEffectSummaryList
    description = PaginatedContestEffectSummaryList
    derivedFrom = Root
    properties {
        count {
          type =  integer
          description = "The total number of resources available from this API."
          optional = true
        }
        next {
          type =  string
          description = "The URL for the next page in the list, or null if there is no next page."
          optional = false
        }
        previous {
          type =  string
          description = "The URL for the previous page in the list, or null if there is no previous page."
          optional = false
        }
        results {
          type = array
          items.type = ContestEffectSummary
          description = "A list of API resources on this page."
          optional = true
        }
    }
  }
}

serviceTemplates {

  PaginatedContestEffectSummaryList {
    title = PaginatedContestEffectSummaryList
    description = PaginatedContestEffectSummaryList
    implements = openapi_server.resourceTypes.PaginatedContestEffectSummaryList

  }
}
