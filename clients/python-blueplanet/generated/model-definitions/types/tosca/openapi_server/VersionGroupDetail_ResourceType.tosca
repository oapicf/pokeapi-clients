"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server VersionGroupDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a VersionGroupDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  GenerationSummary = openapi_server.resourceTypes.GenerationSummary
  MoveLearnMethodSummary = openapi_server.resourceTypes.MoveLearnMethodSummary
  PokedexSummary = openapi_server.resourceTypes.PokedexSummary
  RegionSummary = openapi_server.resourceTypes.RegionSummary
  VersionSummary = openapi_server.resourceTypes.VersionSummary
}
resourceTypes {

  VersionGroupDetail {
    title = VersionGroupDetail
    description = VersionGroupDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        order {
          type =  integer
          description = "Order for sorting. Almost by date of release, except similar versions are grouped together."
          optional = false
        }
        generation {
          type = GenerationSummary
          description = "The generation this version was introduced in."
          optional = true
        }
        move_learn_methods {
          type = array
          items.type = MoveLearnMethodSummary
          description = "A list of methods in which Pokémon can learn moves in this version group."
          optional = true
        }
        pokedexes {
          type = array
          items.type = PokedexSummary
          description = "A list of Pokédexes introduces in this version group."
          optional = true
        }
        regions {
          type = array
          items.type = RegionSummary
          description = "A list of regions that can be visited in this version group."
          optional = true
        }
        versions {
          type = array
          items.type = VersionSummary
          description = "The versions this version group owns."
          optional = true
        }
    }
  }
}

serviceTemplates {

  VersionGroupDetail {
    title = VersionGroupDetail
    description = VersionGroupDetail
    implements = openapi_server.resourceTypes.VersionGroupDetail

  }
}
