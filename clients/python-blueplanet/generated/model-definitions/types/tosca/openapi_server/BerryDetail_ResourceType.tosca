"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server BerryDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a BerryDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  BerryFirmnessSummary = openapi_server.resourceTypes.BerryFirmnessSummary
  BerryFlavorMap = openapi_server.resourceTypes.BerryFlavorMap
  ItemSummary = openapi_server.resourceTypes.ItemSummary
  TypeSummary = openapi_server.resourceTypes.TypeSummary
}
resourceTypes {

  BerryDetail {
    title = BerryDetail
    description = BerryDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        growth_time {
          type =  integer
          description = "Time it takes the tree to grow one stage, in hours. Berry trees go through four of these growth stages before they can be picked."
          optional = false
        }
        max_harvest {
          type =  integer
          description = "The maximum number of these berries that can grow on one tree in Generation IV."
          optional = false
        }
        natural_gift_power {
          type =  integer
          description = "The power of the move \&quot;Natural Gift\&quot; when used with this Berry."
          optional = false
        }
        size {
          type =  integer
          description = "The size of this Berry, in millimeters."
          optional = false
        }
        smoothness {
          type =  integer
          description = "The smoothness of this Berry, used in making Pokéblocks or Poffins."
          optional = false
        }
        soil_dryness {
          type =  integer
          description = "The speed at which this Berry dries out the soil as it grows. A higher rate means the soil dries more quickly."
          optional = false
        }
        firmness {
          type = BerryFirmnessSummary
          description = "The firmness of this berry, used in making Pokéblocks or Poffins."
          optional = true
        }
        flavors {
          type = array
          items.type = BerryFlavorMap
          description = "A list of references to each flavor a berry can have and the potency of each of those flavors in regard to this berry."
          optional = true
        }
        item {
          type = ItemSummary
          description = "Berries are actually items. This is a reference to the item specific data for this berry."
          optional = true
        }
        natural_gift_type {
          type = TypeSummary
          description = "The type inherited by \&quot;Natural Gift\&quot; when used with this Berry."
          optional = true
        }
    }
  }
}

serviceTemplates {

  BerryDetail {
    title = BerryDetail
    description = BerryDetail
    implements = openapi_server.resourceTypes.BerryDetail

  }
}
