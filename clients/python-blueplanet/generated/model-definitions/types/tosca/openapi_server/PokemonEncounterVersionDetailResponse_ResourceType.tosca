"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PokemonEncounterVersionDetailResponse"
package     = openapi_server
version     = "1.0"
description = "Defines a PokemonEncounterVersionDetailResponse"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  PokemonEncounterDetailResponse = openapi_server.resourceTypes.PokemonEncounterDetailResponse
  VersionSummary = openapi_server.resourceTypes.VersionSummary
}
resourceTypes {

  PokemonEncounterVersionDetailResponse {
    title = PokemonEncounterVersionDetailResponse
    description = PokemonEncounterVersionDetailResponse
    derivedFrom = Root
    properties {
        version {
          type = VersionSummary
          description = "The game version this encounter happens in."
          optional = true
        }
        max_chance {
          type =  integer
          description = "The total percentage of all encounter potential."
          optional = true
        }
        encounter_details {
          type = array
          items.type = PokemonEncounterDetailResponse
          description = "A list of encounters and their specifics."
          optional = true
        }
    }
  }
}

serviceTemplates {

  PokemonEncounterVersionDetailResponse {
    title = PokemonEncounterVersionDetailResponse
    description = PokemonEncounterVersionDetailResponse
    implements = openapi_server.resourceTypes.PokemonEncounterVersionDetailResponse

  }
}
