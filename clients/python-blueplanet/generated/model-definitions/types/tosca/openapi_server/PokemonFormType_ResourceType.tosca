"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PokemonFormType"
package     = openapi_server
version     = "1.0"
description = "Defines a PokemonFormType"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  TypeSummary = openapi_server.resourceTypes.TypeSummary
}
resourceTypes {

  PokemonFormType {
    title = PokemonFormType
    description = PokemonFormType
    derivedFrom = Root
    properties {
        slot {
          type =  integer
          description = "The order the Pokémon&#39;s types are listed in."
          optional = true
        }
        type {
          type = TypeSummary
          description = "The type the referenced Form has."
          optional = true
        }
    }
  }
}

serviceTemplates {

  PokemonFormType {
    title = PokemonFormType
    description = PokemonFormType
    implements = openapi_server.resourceTypes.PokemonFormType

  }
}
