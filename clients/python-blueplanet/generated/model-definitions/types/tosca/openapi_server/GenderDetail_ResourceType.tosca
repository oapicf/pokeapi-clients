"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server GenderDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a GenderDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  GenderPokemonSpecies = openapi_server.resourceTypes.GenderPokemonSpecies
  PokemonSpeciesSummary = openapi_server.resourceTypes.PokemonSpeciesSummary
}
resourceTypes {

  GenderDetail {
    title = GenderDetail
    description = GenderDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        pokemon_species_details {
          type = array
          items.type = GenderPokemonSpecies
          description = "A list of Pokémon species that can be this gender and how likely it is that they will be."
          optional = true
        }
        required_for_evolution {
          type = array
          items.type = PokemonSpeciesSummary
          description = "A list of Pokémon species that required this gender in order for a Pokémon to evolve into them."
          optional = true
        }
    }
  }
}

serviceTemplates {

  GenderDetail {
    title = GenderDetail
    description = GenderDetail
    implements = openapi_server.resourceTypes.GenderDetail

  }
}
