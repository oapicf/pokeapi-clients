"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server ItemDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a ItemDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  EvolutionChainSummary = openapi_server.resourceTypes.EvolutionChainSummary
  ItemAttributeSummary = openapi_server.resourceTypes.ItemAttributeSummary
  ItemCategorySummary = openapi_server.resourceTypes.ItemCategorySummary
  ItemEffectText = openapi_server.resourceTypes.ItemEffectText
  ItemFlavorText = openapi_server.resourceTypes.ItemFlavorText
  ItemFlingEffectSummary = openapi_server.resourceTypes.ItemFlingEffectSummary
  ItemGameIndex = openapi_server.resourceTypes.ItemGameIndex
  ItemMachine = openapi_server.resourceTypes.ItemMachine
  ItemName = openapi_server.resourceTypes.ItemName
  ItemPrice = openapi_server.resourceTypes.ItemPrice
  ItemSprites = openapi_server.resourceTypes.ItemSprites
  PokemonHeldItem = openapi_server.resourceTypes.PokemonHeldItem
}
resourceTypes {

  ItemDetail {
    title = ItemDetail
    description = ItemDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        fling_power {
          type =  integer
          description = "The power of the move Fling when used with this item."
          optional = false
        }
        fling_effect {
          type = ItemFlingEffectSummary
          description = "The effect of the move Fling when used with this item."
          optional = true
        }
        attributes {
          type = array
          items.type = ItemAttributeSummary
          description = "A list of attributes this item has."
          optional = true
        }
        category {
          type = ItemCategorySummary
          description = "The category of items this item falls into."
          optional = true
        }
        effect_entries {
          type = array
          items.type = ItemEffectText
          description = "The effect of this ability listed in different languages."
          optional = true
        }
        flavor_text_entries {
          type = array
          items.type = ItemFlavorText
          description = "The flavor text of this ability listed in different languages."
          optional = true
        }
        game_indices {
          type = array
          items.type = ItemGameIndex
          description = "A list of game indices relevent to this item by generation."
          optional = true
        }
        prices {
          type = array
          items.type = ItemPrice
          description = "Purchase and sell prices by currency and version group. Prices may be null when the item cannot be bought or sold."
          optional = true
        }
        names {
          type = array
          items.type = ItemName
          description = "The name of this item listed in different languages."
          optional = true
        }
        held_by_pokemon {
          type = array
          items.type = PokemonHeldItem
          description = "A list of Pokémon that might be found in the wild holding this item."
          optional = true
        }
        sprites {
          type = ItemSprites
          description = "A set of sprites used to depict this item in the game."
          optional = true
        }
        baby_trigger_for {
          type = EvolutionChainSummary
          description = "An evolution chain this item requires to produce a bay during mating."
          optional = true
        }
        machines {
          type = array
          items.type = ItemMachine
          description = "A list of the machines related to this item."
          optional = true
        }
    }
  }
}

serviceTemplates {

  ItemDetail {
    title = ItemDetail
    description = ItemDetail
    implements = openapi_server.resourceTypes.ItemDetail

  }
}
