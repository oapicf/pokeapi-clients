"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server GrowthRateDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a GrowthRateDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  Experience = openapi_server.resourceTypes.Experience
  GrowthRateDescription = openapi_server.resourceTypes.GrowthRateDescription
  PokemonSpeciesSummary = openapi_server.resourceTypes.PokemonSpeciesSummary
}
resourceTypes {

  GrowthRateDetail {
    title = GrowthRateDetail
    description = GrowthRateDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        formula {
          type =  string
          description = "The formula used to calculate the rate at which the Pokémon species gains level."
          optional = true
        }
        descriptions {
          type = array
          items.type = GrowthRateDescription
          description = "The descriptions of this characteristic listed in different languages."
          optional = true
        }
        levels {
          type = array
          items.type = Experience
          description = "A list of levels and the amount of experienced needed to atain them based on this growth rate."
          optional = true
        }
        pokemon_species {
          type = array
          items.type = PokemonSpeciesSummary
          description = "A list of Pokémon species that gain levels at this growth rate."
          optional = true
        }
    }
  }
}

serviceTemplates {

  GrowthRateDetail {
    title = GrowthRateDetail
    description = GrowthRateDetail
    implements = openapi_server.resourceTypes.GrowthRateDetail

  }
}
