"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PokedexDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a PokedexDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  PokedexDescription = openapi_server.resourceTypes.PokedexDescription
  PokedexName = openapi_server.resourceTypes.PokedexName
  PokemonDexNumber = openapi_server.resourceTypes.PokemonDexNumber
  RegionSummary = openapi_server.resourceTypes.RegionSummary
  VersionGroupSummary = openapi_server.resourceTypes.VersionGroupSummary
}
resourceTypes {

  PokedexDetail {
    title = PokedexDetail
    description = PokedexDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        is_main_series {
          type =  boolean
          description = "Whether or not this Pokédex originated in the main series of the video games."
          optional = false
        }
        descriptions {
          type = array
          items.type = PokedexDescription
          description = "The description of this resource listed in different languages."
          optional = true
        }
        names {
          type = array
          items.type = PokedexName
          description = "The name of this resource listed in different languages."
          optional = true
        }
        pokemon_entries {
          type = array
          items.type = PokemonDexNumber
          description = "A list of Pokémon catalogued in this Pokédex and their indexes."
          optional = true
        }
        region {
          type = RegionSummary
          description = "The region this Pokédex catalogues Pokémon for."
          optional = true
        }
        version_groups {
          type = array
          items.type = VersionGroupSummary
          description = "A list of version groups this Pokédex is relevant to."
          optional = true
        }
    }
  }
}

serviceTemplates {

  PokedexDetail {
    title = PokedexDetail
    description = PokedexDetail
    implements = openapi_server.resourceTypes.PokedexDetail

  }
}
