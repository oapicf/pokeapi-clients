"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server MoveChange"
package     = openapi_server
version     = "1.0"
description = "Defines a MoveChange"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  MoveEffectEffectText = openapi_server.resourceTypes.MoveEffectEffectText
  TypeSummary = openapi_server.resourceTypes.TypeSummary
  VersionGroupSummary = openapi_server.resourceTypes.VersionGroupSummary
}
resourceTypes {

  MoveChange {
    title = MoveChange
    description = MoveChange
    derivedFrom = Root
    properties {
        accuracy {
          type =  integer
          description = "The percent value of how likely this move is to be successful."
          optional = false
        }
        power {
          type =  integer
          description = "The base power before the listed version group, or null if power did not change."
          optional = false
        }
        pp {
          type =  integer
          description = "Power points. The number of times this move can be used."
          optional = false
        }
        effect_chance {
          type =  integer
          description = "The percent value of how likely it is this moves effect will take effect."
          optional = true
        }
        effect_entries {
          type = array
          items.type = MoveEffectEffectText
          description = "The effect of this move listed in different languages."
          optional = true
        }
        type {
          type = TypeSummary
          description = "The elemental type of this move."
          optional = true
        }
        version_group {
          type = VersionGroupSummary
          description = "The version group in which these move stat values were in effect."
          optional = true
        }
    }
  }
}

serviceTemplates {

  MoveChange {
    title = MoveChange
    description = MoveChange
    implements = openapi_server.resourceTypes.MoveChange

  }
}
