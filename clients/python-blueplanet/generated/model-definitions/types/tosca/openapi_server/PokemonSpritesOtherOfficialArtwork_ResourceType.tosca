"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PokemonSpritesOtherOfficialArtwork"
package     = openapi_server
version     = "1.0"
description = "Defines a PokemonSpritesOtherOfficialArtwork"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
}
resourceTypes {

  PokemonSpritesOtherOfficialArtwork {
    title = PokemonSpritesOtherOfficialArtwork
    description = PokemonSpritesOtherOfficialArtwork
    derivedFrom = Root
    properties {
        front_default {
          type =  string
          description = "The URL of the default front official artwork, or null if unavailable."
          optional = true
        }
        front_shiny {
          type =  string
          description = "The URL of the shiny front official artwork, or null if unavailable."
          optional = true
        }
        versions {
          # TODO
          description = "Additional official artwork grouped by version. Available keys vary by resource."
          optional = false
        }
    }
  }
}

serviceTemplates {

  PokemonSpritesOtherOfficialArtwork {
    title = PokemonSpritesOtherOfficialArtwork
    description = PokemonSpritesOtherOfficialArtwork
    implements = openapi_server.resourceTypes.PokemonSpritesOtherOfficialArtwork

  }
}
