"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server LocationAreaPokemonEncounterVersion"
package     = openapi_server
version     = "1.0"
description = "Defines a LocationAreaPokemonEncounterVersion"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  LocationAreaEncounterDetail = openapi_server.resourceTypes.LocationAreaEncounterDetail
  VersionSummary = openapi_server.resourceTypes.VersionSummary
}
resourceTypes {

  LocationAreaPokemonEncounterVersion {
    title = LocationAreaPokemonEncounterVersion
    description = LocationAreaPokemonEncounterVersion
    derivedFrom = Root
    properties {
        version {
          type = VersionSummary
          description = "The game version this encounter happens in."
          optional = true
        }
        max_chance {
          type =  integer
          description = "The total percentage of all encounter potential."
          optional = true
        }
        encounter_details {
          type = array
          items.type = LocationAreaEncounterDetail
          description = "A list of encounters and their specifics."
          optional = true
        }
    }
  }
}

serviceTemplates {

  LocationAreaPokemonEncounterVersion {
    title = LocationAreaPokemonEncounterVersion
    description = LocationAreaPokemonEncounterVersion
    implements = openapi_server.resourceTypes.LocationAreaPokemonEncounterVersion

  }
}
