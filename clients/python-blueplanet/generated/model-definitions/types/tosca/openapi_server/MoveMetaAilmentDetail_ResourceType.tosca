"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server MoveMetaAilmentDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a MoveMetaAilmentDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  MoveMetaAilmentName = openapi_server.resourceTypes.MoveMetaAilmentName
  MoveSummary = openapi_server.resourceTypes.MoveSummary
}
resourceTypes {

  MoveMetaAilmentDetail {
    title = MoveMetaAilmentDetail
    description = MoveMetaAilmentDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        moves {
          type = array
          items.type = MoveSummary
          description = "A list of moves that cause this ailment."
          optional = true
        }
        names {
          type = array
          items.type = MoveMetaAilmentName
          description = "The name of this resource listed in different languages."
          optional = true
        }
    }
  }
}

serviceTemplates {

  MoveMetaAilmentDetail {
    title = MoveMetaAilmentDetail
    description = MoveMetaAilmentDetail
    implements = openapi_server.resourceTypes.MoveMetaAilmentDetail

  }
}
