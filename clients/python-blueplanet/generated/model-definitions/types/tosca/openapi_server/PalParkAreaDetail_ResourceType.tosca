"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server PalParkAreaDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a PalParkAreaDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  PalParkAreaName = openapi_server.resourceTypes.PalParkAreaName
  PalParkEncounter = openapi_server.resourceTypes.PalParkEncounter
}
resourceTypes {

  PalParkAreaDetail {
    title = PalParkAreaDetail
    description = PalParkAreaDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        names {
          type = array
          items.type = PalParkAreaName
          description = "The name of this resource listed in different languages."
          optional = true
        }
        pokemon_encounters {
          type = array
          items.type = PalParkEncounter
          description = "A list of Pokémon encountered in thi pal park area along with details."
          optional = true
        }
    }
  }
}

serviceTemplates {

  PalParkAreaDetail {
    title = PalParkAreaDetail
    description = PalParkAreaDetail
    implements = openapi_server.resourceTypes.PalParkAreaDetail

  }
}
