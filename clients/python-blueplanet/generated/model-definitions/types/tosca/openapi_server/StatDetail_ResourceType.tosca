"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server StatDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a StatDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  CharacteristicSummary = openapi_server.resourceTypes.CharacteristicSummary
  ItemSummary = openapi_server.resourceTypes.ItemSummary
  MoveDamageClassSummary = openapi_server.resourceTypes.MoveDamageClassSummary
  StatAffectingMoves = openapi_server.resourceTypes.StatAffectingMoves
  StatAffectingNatures = openapi_server.resourceTypes.StatAffectingNatures
  StatName = openapi_server.resourceTypes.StatName
}
resourceTypes {

  StatDetail {
    title = StatDetail
    description = StatDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        game_index {
          type =  integer
          description = "ID the games use for this stat."
          optional = true
        }
        is_battle_only {
          type =  boolean
          description = "Whether this stat only exists within a battle."
          optional = false
        }
        affecting_moves {
          type = StatAffectingMoves
          description = "A detail of moves which affect this stat positively or negatively."
          optional = true
        }
        affecting_natures {
          type = StatAffectingNatures
          description = "A detail of natures which affect this stat positively or negatively."
          optional = true
        }
        affecting_items {
          type = array
          items.type = ItemSummary
          description = "Items that affect this stat, such as vitamins and battle items."
          optional = true
        }
        characteristics {
          type = array
          items.type = CharacteristicSummary
          description = "A list of characteristics that are set on a Pokémon when its highest base stat is this stat."
          optional = true
        }
        move_damage_class {
          type = MoveDamageClassSummary
          description = "The class of damage this stat is directly related to."
          optional = true
        }
        names {
          type = array
          items.type = StatName
          description = "The name of this resource listed in different languages."
          optional = true
        }
    }
  }
}

serviceTemplates {

  StatDetail {
    title = StatDetail
    description = StatDetail
    implements = openapi_server.resourceTypes.StatDetail

  }
}
