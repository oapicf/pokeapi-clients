"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server RegionDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a RegionDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  GenerationSummary = openapi_server.resourceTypes.GenerationSummary
  LocationSummary = openapi_server.resourceTypes.LocationSummary
  PokedexSummary = openapi_server.resourceTypes.PokedexSummary
  RegionName = openapi_server.resourceTypes.RegionName
  VersionGroupSummary = openapi_server.resourceTypes.VersionGroupSummary
}
resourceTypes {

  RegionDetail {
    title = RegionDetail
    description = RegionDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        locations {
          type = array
          items.type = LocationSummary
          description = "A list of locations that can be found in this region."
          optional = true
        }
        main_generation {
          type = GenerationSummary
          description = "The generation this region was introduced in."
          optional = true
        }
        names {
          type = array
          items.type = RegionName
          description = "The name of this resource listed in different languages."
          optional = true
        }
        pokedexes {
          type = array
          items.type = PokedexSummary
          description = "A list of pokédexes that catalogue Pokémon in this region."
          optional = true
        }
        version_groups {
          type = array
          items.type = VersionGroupSummary
          description = "A list of version groups where this region can be visited."
          optional = true
        }
    }
  }
}

serviceTemplates {

  RegionDetail {
    title = RegionDetail
    description = RegionDetail
    implements = openapi_server.resourceTypes.RegionDetail

  }
}
