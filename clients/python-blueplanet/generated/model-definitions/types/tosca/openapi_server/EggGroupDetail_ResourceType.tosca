"$schema"   = "http://cyaninc.com/json-schemas/tosca-lite-v1/definition-module#"
title       = "openapi_server EggGroupDetail"
package     = openapi_server
version     = "1.0"
description = "Defines a EggGroupDetail"
authors     = ["F. Bar (foo@bar.baz)"]

imports {
  Root = tosca.resourceTypes.Root
  EggGroupName = openapi_server.resourceTypes.EggGroupName
  PokemonSpeciesSummary = openapi_server.resourceTypes.PokemonSpeciesSummary
}
resourceTypes {

  EggGroupDetail {
    title = EggGroupDetail
    description = EggGroupDetail
    derivedFrom = Root
    properties {
        id {
          type =  integer
          description = "The identifier for this resource."
          optional = true
        }
        name {
          type =  string
          description = "The name for this resource."
          optional = true
        }
        names {
          type = array
          items.type = EggGroupName
          description = "The name of this resource listed in different languages."
          optional = true
        }
        pokemon_species {
          type = array
          items.type = PokemonSpeciesSummary
          description = "A list of all Pokémon species that are members of this egg group."
          optional = true
        }
    }
  }
}

serviceTemplates {

  EggGroupDetail {
    title = EggGroupDetail
    description = EggGroupDetail
    implements = openapi_server.resourceTypes.EggGroupDetail

  }
}
