@startuml

title PokéAPI Schemas Diagram

entity AbilityChange {
    * version_group: VersionGroupSummary
    * effect_entries: List<AbilityChangeEffectText>
}

entity AbilityChangeEffectText {
    * effect: String
    * language: LanguageSummary
}

entity AbilityDetail {
    * id: Integer
    * name: String
    is_main_series: Boolean
    * generation: GenerationSummary
    * names: List<AbilityName>
    * effect_entries: List<AbilityEffectText>
    * effect_changes: List<AbilityChange>
    * flavor_text_entries: List<AbilityFlavorText>
    * pokemon: List<AbilityPokemonDetail>
}

entity AbilityEffectText {
    * effect: String
    * short_effect: String
    * language: LanguageSummary
}

entity AbilityFlavorText {
    * flavor_text: String
    * language: LanguageSummary
    * version_group: VersionGroupSummary
}

entity AbilityName {
    * name: String
    * language: LanguageSummary
}

entity AbilityPokemonDetail {
    is_hidden: Boolean
    * slot: Integer
    * pokemon: PokemonSummary
}

entity AbilitySummary {
    * name: String
    * url: URI
}

entity BerryDetail {
    * id: Integer
    * name: String
    growth_time: Integer
    max_harvest: Integer
    natural_gift_power: Integer
    size: Integer
    smoothness: Integer
    soil_dryness: Integer
    * firmness: BerryFirmnessSummary
    * flavors: List<BerryFlavorMap>
    * item: ItemSummary
    * natural_gift_type: TypeSummary
}

entity BerryFirmnessDetail {
    * id: Integer
    * name: String
    * berries: List<BerrySummary>
    * names: List<BerryFirmnessName>
}

entity BerryFirmnessName {
    * name: String
    * language: LanguageSummary
}

entity BerryFirmnessSummary {
    * name: String
    * url: URI
}

entity BerryFlavorBerryMap {
    * potency: Integer
    * berry: BerrySummary
}

entity BerryFlavorDetail {
    * id: Integer
    * name: String
    * berries: List<BerryFlavorBerryMap>
    * contest_type: ContestTypeSummary
    * names: List<BerryFlavorName>
}

entity BerryFlavorMap {
    * potency: Integer
    * flavor: BerryFlavorSummary
}

entity BerryFlavorName {
    * name: String
    * language: LanguageSummary
}

entity BerryFlavorSummary {
    * name: String
    * url: URI
}

entity BerrySummary {
    * name: String
    * url: URI
}

entity CharacteristicDescription {
    description: String
    * language: LanguageSummary
}

entity CharacteristicDetail {
    * id: Integer
    * gene_modulo: Integer
    * possible_values: List<Integer>
    * highest_stat: StatSummary
    * descriptions: List<CharacteristicDescription>
}

entity CharacteristicSummary {
    * url: URI
}

entity ContestEffectDetail {
    * id: Integer
    * appeal: Integer
    * jam: Integer
    * effect_entries: List<ContestEffectEffectText>
    * flavor_text_entries: List<ContestEffectFlavorText>
}

entity ContestEffectEffectText {
    * effect: String
    * language: LanguageSummary
}

entity ContestEffectFlavorText {
    * flavor_text: String
    * language: LanguageSummary
}

entity ContestEffectSummary {
    * url: URI
}

entity ContestTypeDetail {
    * id: Integer
    * name: String
    * berry_flavor: BerryFlavorSummary
    * names: List<ContestTypeName>
}

entity ContestTypeName {
    * name: String
    * color: String
    * language: LanguageSummary
}

entity ContestTypeSummary {
    * name: String
    * url: URI
}

entity CurrencyDetail {
    * id: Integer
    * name: String
    * names: List<CurrencyName>
}

entity CurrencyName {
    * name: String
    * language: LanguageSummary
}

entity CurrencySummary {
    * name: String
    * url: URI
}

entity EggGroupDetail {
    * id: Integer
    * name: String
    * names: List<EggGroupName>
    * pokemon_species: List<PokemonSpeciesSummary>
}

entity EggGroupName {
    * name: String
    * language: LanguageSummary
}

entity EggGroupSummary {
    * name: String
    * url: URI
}

entity EncounterConditionDetail {
    * id: Integer
    * name: String
    * values: List<EncounterConditionValueSummary>
    * names: List<EncounterConditionName>
}

entity EncounterConditionName {
    * name: String
    * language: LanguageSummary
}

entity EncounterConditionSummary {
    * name: String
    * url: URI
}

entity EncounterConditionValueDetail {
    * id: Integer
    * name: String
    * condition: EncounterConditionSummary
    * names: List<EncounterConditionValueName>
}

entity EncounterConditionValueName {
    * name: String
    * language: LanguageSummary
}

entity EncounterConditionValueSummary {
    * name: String
    * url: URI
}

entity EncounterMethodDetail {
    * id: Integer
    * name: String
    order: Integer
    * names: List<EncounterMethodName>
}

entity EncounterMethodName {
    * name: String
    * language: LanguageSummary
}

entity EncounterMethodSummary {
    * name: String
    * url: URI
}

entity EncounterPokemonDetail {
    min_perfect_ivs: Integer
    always_shiny: Boolean
    never_shiny: Boolean
    is_alpha: Boolean
}

entity EvolutionChainDetail {
    * id: Integer
    * baby_trigger_item: ItemSummary
    * chain: EvolutionChainLink
}

entity EvolutionChainLink {
    * is_baby: Boolean
    * species: PokemonSpeciesSummary
    * evolution_details: List<PokemonEvolution>
    * evolves_to: List<EvolutionChainLink>
}

entity EvolutionChainSummary {
    * url: URI
}

entity EvolutionConditionExpression {
    * expression: String
    * percentage_chance: Double
    * variables: List<EvolutionVariableSummary>
}

entity EvolutionTriggerDetail {
    * id: Integer
    * name: String
    * names: List<EvolutionTriggerName>
    * pokemon_species: List<PokemonSpeciesSummary>
}

entity EvolutionTriggerName {
    * name: String
    * language: LanguageSummary
}

entity EvolutionTriggerSummary {
    * name: String
    * url: URI
}

entity EvolutionVariableDescription {
    description: String
    * language: LanguageSummary
}

entity EvolutionVariableDetail {
    * id: Integer
    * name: String
    * symbol: String
    data_type: String
    source: String
    * version_group: VersionGroupSummary
    * names: List<EvolutionVariableName>
    * descriptions: List<EvolutionVariableDescription>
}

entity EvolutionVariableName {
    * name: String
    * language: LanguageSummary
}

entity EvolutionVariableSummary {
    * name: String
    * url: URI
}

entity Experience {
    * level: Integer
    * experience: Integer
}

entity GenderDetail {
    * id: Integer
    * name: String
    * pokemon_species_details: List<GenderPokemonSpecies>
    * required_for_evolution: List<PokemonSpeciesSummary>
}

entity GenderPokemonSpecies {
    * rate: Integer
    * pokemon_species: PokemonSpeciesSummary
}

entity GenderSummary {
    * name: String
    * url: URI
}

entity GenerationDetail {
    * id: Integer
    * name: String
    * abilities: List<AbilitySummary>
    * main_region: RegionSummary
    * moves: List<MoveSummary>
    * names: List<GenerationName>
    * pokemon_species: List<PokemonSpeciesSummary>
    * types: List<TypeSummary>
    * version_groups: List<VersionGroupSummary>
}

entity GenerationName {
    * name: String
    * language: LanguageSummary
}

entity GenerationSummary {
    * name: String
    * url: URI
}

entity GrowthRateDescription {
    description: String
    * language: LanguageSummary
}

entity GrowthRateDetail {
    * id: Integer
    * name: String
    * formula: String
    * descriptions: List<GrowthRateDescription>
    * levels: List<Experience>
    * pokemon_species: List<PokemonSpeciesSummary>
}

entity GrowthRateSummary {
    * name: String
    * url: URI
}

entity ItemAttributeDescription {
    description: String
    * language: LanguageSummary
}

entity ItemAttributeDetail {
    * id: Integer
    * name: String
    * descriptions: List<ItemAttributeDescription>
    * items: List<ItemSummary>
    * names: List<ItemAttributeName>
}

entity ItemAttributeName {
    * name: String
    * language: LanguageSummary
}

entity ItemAttributeSummary {
    * name: String
    * url: URI
}

entity ItemCategoryDetail {
    * id: Integer
    * name: String
    * items: List<ItemSummary>
    * names: List<ItemCategoryName>
    * pocket: ItemPocketSummary
}

entity ItemCategoryName {
    * name: String
    * language: LanguageSummary
}

entity ItemCategorySummary {
    * name: String
    * url: URI
}

entity ItemDetail {
    * id: Integer
    * name: String
    fling_power: Integer
    * fling_effect: ItemFlingEffectSummary
    * attributes: List<ItemAttributeSummary>
    * category: ItemCategorySummary
    * effect_entries: List<ItemEffectText>
    * flavor_text_entries: List<ItemFlavorText>
    * game_indices: List<ItemGameIndex>
    * prices: List<ItemPrice>
    * names: List<ItemName>
    * held_by_pokemon: List<PokemonHeldItem>
    * sprites: ItemSprites
    * baby_trigger_for: EvolutionChainSummary
    * machines: List<ItemMachine>
}

entity ItemEffectText {
    * effect: String
    * short_effect: String
    * language: LanguageSummary
}

entity ItemFlavorText {
    * text: String
    * version_group: VersionGroupSummary
    * language: LanguageSummary
}

entity ItemFlingEffectDetail {
    * id: Integer
    * name: String
    * effect_entries: List<ItemFlingEffectEffectText>
    * items: List<ItemSummary>
}

entity ItemFlingEffectEffectText {
    * effect: String
    * language: LanguageSummary
}

entity ItemFlingEffectSummary {
    * name: String
    * url: URI
}

entity ItemGameIndex {
    * game_index: Integer
    * generation: GenerationSummary
}

entity ItemMachine {
    * machine: MachineSummary
    * version_group: VersionGroupSummary
}

entity ItemName {
    * name: String
    * language: LanguageSummary
}

entity ItemPocketDetail {
    * id: Integer
    * name: String
    * categories: List<ItemCategorySummary>
    * names: List<ItemPocketName>
}

entity ItemPocketName {
    * name: String
    * language: LanguageSummary
}

entity ItemPocketSummary {
    * name: String
    * url: URI
}

entity ItemPrice {
    purchase_price: Integer
    sell_price: Integer
    * currency: CurrencySummary
    * version_group: VersionGroupSummary
}

entity ItemSprites {
    * default: String
}

entity ItemSummary {
    * name: String
    * url: URI
}

entity LanguageDetail {
    * id: Integer
    * name: String
    official: Boolean
    * iso639: String
    * iso3166: String
    * names: List<LanguageName>
}

entity LanguageName {
    * name: String
    * language: LanguageSummary
}

entity LanguageSummary {
    * name: String
    * url: URI
}

entity LocationAreaDetail {
    * id: Integer
    * name: String
    * game_index: Integer
    * encounter_method_rates: List<LocationAreaEncounterRate>
    * location: LocationSummary
    * names: List<LocationAreaName>
    * pokemon_encounters: List<LocationAreaPokemonEncounter>
}

entity LocationAreaEncounterDetail {
    * min_level: Integer
    * max_level: Integer
    chance: Integer
    method: EncounterMethodSummary
    * condition_values: List<EncounterConditionValueSummary>
    * pokemon_details: EncounterPokemonDetail
}

entity LocationAreaEncounterRate {
    * encounter_method: EncounterMethodSummary
    * version_details: List<LocationAreaEncounterVersionDetail>
}

entity LocationAreaEncounterVersionDetail {
    * rate: Integer
    * version: VersionSummary
}

entity LocationAreaName {
    * name: String
    * language: LanguageSummary
}

entity LocationAreaPokemonEncounter {
    * pokemon: PokemonSummary
    * version_details: List<LocationAreaPokemonEncounterVersion>
}

entity LocationAreaPokemonEncounterVersion {
    * version: VersionSummary
    * max_chance: Integer
    * encounter_details: List<LocationAreaEncounterDetail>
}

entity LocationAreaSummary {
    * name: String
    * url: URI
}

entity LocationDetail {
    * id: Integer
    * name: String
    * region: RegionSummary
    * names: List<LocationName>
    * game_indices: List<LocationGameIndex>
    * areas: List<LocationAreaSummary>
}

entity LocationGameIndex {
    * game_index: Integer
    * generation: GenerationSummary
}

entity LocationName {
    * name: String
    * language: LanguageSummary
}

entity LocationSummary {
    * name: String
    * url: URI
}

entity MachineDetail {
    * id: Integer
    * item: ItemSummary
    * version_group: VersionGroupSummary
    * move: MoveSummary
}

entity MachineSummary {
    * url: URI
}

entity MoveBattleStyleDetail {
    * id: Integer
    * name: String
    * names: List<MoveBattleStyleName>
}

entity MoveBattleStyleName {
    * name: String
    * language: LanguageSummary
}

entity MoveBattleStyleSummary {
    * name: String
    * url: URI
}

entity MoveChange {
    accuracy: Integer
    power: Integer
    pp: Integer
    * effect_chance: Integer
    * effect_entries: List<MoveEffectEffectText>
    * type: TypeSummary
    * version_group: VersionGroupSummary
}

entity MoveComboUsage {
    * use_before: List<MoveSummary>
    * use_after: List<MoveSummary>
}

entity MoveCombos {
    * normal: MoveComboUsage
    * super: MoveComboUsage
}

entity MoveDamageClassDescription {
    description: String
    * language: LanguageSummary
}

entity MoveDamageClassDetail {
    * id: Integer
    * name: String
    * descriptions: List<MoveDamageClassDescription>
    * moves: List<MoveSummary>
    * names: List<MoveDamageClassName>
}

entity MoveDamageClassName {
    * name: String
    * language: LanguageSummary
}

entity MoveDamageClassSummary {
    * name: String
    * url: URI
}

entity MoveDetail {
    * id: Integer
    * name: String
    accuracy: Integer
    * effect_chance: Integer
    pp: Integer
    priority: Integer
    power: Integer
    * contest_combos: MoveCombos
    * contest_type: ContestTypeSummary
    * contest_effect: ContestEffectSummary
    * damage_class: MoveDamageClassSummary
    * effect_entries: List<MoveEffectEffectText>
    * effect_changes: List<MoveEffectChange>
    * generation: GenerationSummary
    * meta: MoveMeta
    * names: List<MoveName>
    * past_values: List<MoveChange>
    * stat_changes: List<MoveMetaStatChange>
    * super_contest_effect: SuperContestEffectSummary
    * target: MoveTargetSummary
    * type: TypeSummary
    * machines: List<ItemMachine>
    * flavor_text_entries: List<MoveFlavorText>
    * learned_by_pokemon: List<PokemonSummary>
}

entity MoveEffectChange {
    * version_group: VersionGroupSummary
    * effect_entries: List<MoveEffectChangeEffectText>
}

entity MoveEffectChangeEffectText {
    * effect: String
    * language: LanguageSummary
}

entity MoveEffectEffectText {
    * effect: String
    * short_effect: String
    * language: LanguageSummary
}

entity MoveFlavorText {
