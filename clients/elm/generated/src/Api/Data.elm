encodeAbilityChangeWithTag (tagField, tag) model =
    encodeObject (encodeAbilityChangePairs model ++ [ encode tagField Json.Encode.string tag ])


encodeAbilityChangePairs : AbilityChange -> List EncodedField
encodeAbilityChangePairs model =
    let
        pairs =
            [ encode "version_group" encodeVersionGroupSummary model.versionGroup
